SELECT product_category,
       SUM(transaction_qty*unit_price) AS revenue,
       store_location,
       transaction_date,
       transaction_time,
       CASE
           WHEN transaction_time BETWEEN '06:00:00' AND '11:59:59' THEN '01 Morning'
           WHEN transaction_time BETWEEN '12:00:00' AND '12:59:59' THEN '02 Afternoon'
           WHEN transaction_time BETWEEN '16:00:00' AND '19:59:59' THEN '03 Evening'
           WHEN transaction_time >= '20:00:00' THEN '04 Night'
       END AS time_bucket
FROM bcoffee.public.shop
WHERE transaction_date > '2023-05-03'
GROUP BY product_category,
         store_location,
         transaction_date,
         time_bucket,
         transaction_time
ORDER BY revenue DESC;

